---
interface Milestone {
	date: string;
	title: string;
	desc: string;
	tag?: string;
}

/* 站点魔改时间线：新增节点直接往数组头部追加即可 */
const milestones: Milestone[] = [
	{
		date: "2026.05",
		title: "fork 开源模板，开始魔改",
		desc: "从 Firefly 模板起步，一点一点改成自己的样子。",
		tag: "起点",
	},
];
---

<section class="about-timeline" aria-label="站点更新时间线">
	<ol class="about-timeline__list">
		{milestones.map((milestone, index) => (
			<li
				class="about-timeline__item"
				style={`--i: ${index};`}
			>
				<span class="about-timeline__date">{milestone.date}</span>
				<span class="about-timeline__rail" aria-hidden="true">
					<span class="about-timeline__dot"></span>
				</span>
				<div class="about-timeline__card">
					<div class="about-timeline__card-head">
						<span class="about-timeline__title">{milestone.title}</span>
						{milestone.tag && (
							<span class="about-timeline__tag">{milestone.tag}</span>
						)}
					</div>
					<p class="about-timeline__desc">{milestone.desc}</p>
				</div>
			</li>
		))}
	</ol>
</section>
