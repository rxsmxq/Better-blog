---
import Live2DWidget from "@components/features/Live2DWidget.astro";
import SpineModel from "@components/features/SpineModel.astro";
import ArticleTocPanel from "@components/layout/ArticleTocPanel.astro";
import Footer from "@components/layout/Footer.astro";
import Navbar from "@components/layout/Navbar.astro";
import NavMenuPanel from "@components/layout/NavMenuPanel.astro";
import SideBar from "@components/layout/SideBar.astro";
import SidebarColumn from "@components/layout/SidebarColumn.astro";

import {
	live2dModelConfig,
	navBarConfig,
	sidebarLayoutConfig,
	siteConfig,
	spineModelConfig,
} from "@/config";
import { LinkPresets } from "@/constants/link-presets";
import { isGuestbookPage, isHomePage } from "@/utils/layout-utils";
import { getEffectiveSidebarState } from "@/utils/sidebar-effective-utils";
import Layout from "./Layout.astro";

import "@/styles/markdown.css";
import "@/styles/expressive-code.css";
import "@/styles/toc.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	hasOwnH1?: boolean;
	robots?: string;
	postCategory?: string;
	bannerPostMeta?: {
		title: string;
		published: Date;
		updated?: Date;
		words?: number;
		minutes?: number;
	};
	articleMeta?: {
		published?: Date;
		updated?: Date;
		author?: string;
		category?: string;
		tags?: string[];
	};
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	hasOwnH1 = false,
	robots,
	postCategory,
	bannerPostMeta: _bannerPostMeta,
	articleMeta,
} = Astro.props;

const isPostPage = !!postSlug;
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;

// 侧栏派生状态与列几何（SSR；客户端由 grid-layout-utils 按同一真源重算）
const sidebar = getEffectiveSidebarState({
	isPostPage,
	isHomePage: isHomePage(Astro.url.pathname),
	isGuestbookPage: isGuestbookPage(Astro.url.pathname),
});
const hasMobileBottomComponents =
	sidebarLayoutConfig.enable &&
	sidebarLayoutConfig.mobileBottomComponents.some((comp) => comp.enable);

const navLinks = navBarConfig.links.map((item) => {
	if (typeof item === "number") return LinkPresets[item];
	return item;
});
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} postSlug={postSlug} articleMeta={articleMeta} robots={robots}>
	<slot slot="head" name="head"></slot>

	<div
		id="top-row"
		class="z-50 pointer-events-none relative mx-auto"
		class:list={[
			"sticky top-0 left-0 right-0 z-80 pt-2.5",
			navbarWidthFull ? "w-full" : "w-full max-w-(--page-width) px-0 md:px-4",
		]}
	>
		<div id="navbar-wrapper" class="pointer-events-auto bg-transparent">
			<Navbar></Navbar>
		</div>
	</div>

	<NavMenuPanel links={navLinks} />

	<div class="relative w-full" id="main-grid-wrapper">
		{/* 列几何写在 #main-grid 的内联 style 上，gridDataAttrs 供客户端切页后重算 */}
		<div
			class="mx-auto max-w-[100rem] px-4 md:px-6 mobile-no-sidebar"
			id="main-grid"
			style={sidebar.gridColumnStyle}
			{...sidebar.gridDataAttrs}
		>
			<SidebarColumn
				side="left"
				position={sidebarLayoutConfig.position}
				enable={sidebarLayoutConfig.enable}
				hideSidebarOnPostPage={sidebar.hideSidebarOnPostPage}
				hasLeftComponents={sidebar.hasLeftComponents}
				hasRightComponents={sidebar.hasRightComponents}
				sidebarClass={sidebar.sidebarClass}
			/>

			<div id="content-column" class={sidebar.staticBarClass}>
				<main id="swup-container" class="transition-swup-main" data-current-post-category={postCategory || ""}>
					{isPostPage && <ArticleTocPanel />}
					{/* 页面组件有自己的 H1 时不再输出布局兜底标题，确保每页只有一个 H1。 */}
					{!isPostPage && !hasOwnH1 && <h1 class="sr-only">{title}</h1>}

					<div id="content-wrapper" class="onload-animation">
						<slot></slot>
					</div>
				</main>

				{/* 移动端底部挂件：<768px 时 #main-grid 退回块级布局，必须排在页脚之前 */}
				{hasMobileBottomComponents && (
					<div id="mobile-bottom-sidebar" class="block md:hidden mt-4">
						<SideBar side="bottom" />
					</div>
				)}
			</div>

			<SidebarColumn
				side="right"
				position={sidebarLayoutConfig.position}
				enable={sidebarLayoutConfig.enable}
				hideSidebarOnPostPage={sidebar.hideSidebarOnPostPage}
				hasLeftComponents={sidebar.hasLeftComponents}
				hasRightComponents={sidebar.hasRightComponents}
				sidebarClass={sidebar.sidebarClass}
			/>
		</div>

		{/* Live2D / Spine 移出 #main-grid：否则会成为 grid item 占位影响列几何 */}
		{spineModelConfig.enable && <SpineModel />}
		{live2dModelConfig.enable && <Live2DWidget config={live2dModelConfig} />}

		<Footer></Footer>
	</div>
</Layout>
